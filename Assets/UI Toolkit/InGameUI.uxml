            <ui:Label text="123" style="-unity-font-definition: url(&quot;project://database/Assets/GameAssets/Visuals/Kaph_Font_1_20/OpenType%20(.otf)/Kaph-Regular.otf?fileID=12800000&amp;guid=b6558aa0efa0b4149ad5131051e2c81a&amp;type=3#Kaph-Regular&quot;); font-size: 35px; color: rgb(255, 255, 255); -unity-text-align: lower-left;"/>
