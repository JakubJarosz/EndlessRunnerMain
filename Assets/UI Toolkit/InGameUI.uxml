<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="MainBox" style="flex-grow: 1; width: 330px; height: 205px; position: absolute; top: 20px; left: auto; background-color: rgba(0, 0, 0, 0.306); border-top-left-radius: 0; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 0; padding-left: 29px;">
        <ui:Label text="Distance&#10;" style="-unity-font-definition: url(&quot;project://database/Assets/GameAssets/Visuals/Kaph_Font_1_20/TrueType%20(.ttf)/Kaph-Regular.ttf?fileID=12800000&amp;guid=198d73bfd9f2ce5489162b0c8be2399e&amp;type=3#Kaph-Regular&quot;); color: rgb(185, 143, 59); font-size: 25px; margin-left: 2px;"/>
        <ui:Label text="1200 m." style="-unity-font-definition: url(&quot;project://database/Assets/GameAssets/Visuals/Kaph_Font_1_20/OpenType%20(.otf)/Kaph-Regular.otf?fileID=12800000&amp;guid=b6558aa0efa0b4149ad5131051e2c81a&amp;type=3#Kaph-Regular&quot;); font-size: 35px; color: rgb(255, 255, 255);"/>
        <ui:Label text="Coins" style="font-size: 25px; color: rgb(185, 143, 59); -unity-font-definition: url(&quot;project://database/Assets/GameAssets/Visuals/Kaph_Font_1_20/OpenType%20(.otf)/Kaph-Regular.otf?fileID=12800000&amp;guid=b6558aa0efa0b4149ad5131051e2c81a&amp;type=3#Kaph-Regular&quot;);"/>
