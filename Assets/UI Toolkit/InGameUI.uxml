    <ui:VisualElement name="SpeedBox" style="flex-grow: 1; position: absolute; width: 200px; height: 110px; top: 20px; right: 50%; translate: 50% 0; background-color: rgba(0, 0, 0, 0.306); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
