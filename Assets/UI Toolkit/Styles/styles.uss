:root {
}

.text {
    -unity-font-definition: url("project://database/Assets/GameAssets/Visuals/Kaph_Font_1_20/OpenType%20(.otf)/Kaph-Regular.otf?fileID=12800000&guid=b6558aa0efa0b4149ad5131051e2c81a&type=3#Kaph-Regular");
    color: rgb(253, 253, 253);
    font-size: 18px;
}

.inputContainer {
    background-image: url("project://database/Assets/GameAssets/Visuals/UI/UIElements/sh_chamfer-rect_small_01_512.png?fileID=2800000&guid=b8b9898e893c5844ea7ebe008f1cc2cf&type=3#sh_chamfer-rect_small_01_512");
    -unity-background-image-tint-color: rgb(41, 37, 37);
    background-size: 200px 200px;
    width: 250px;
    height: 250px;
}

.button {
}

.button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

.button:active {
    scale: 0.9 0.9;
}
