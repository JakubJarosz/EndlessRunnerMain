<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/styles.uss?fileID=7433441132597879392&amp;guid=6549a50296b529a4ab69f98bf7ca51a8&amp;type=3#styles"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; justify-content: flex-start; align-items: center; align-self: auto; align-content: center; opacity: 1; position: relative; width: 100%; height: 100%; flex-direction: column; display: flex; -unity-background-scale-mode: scale-to-fit; -unity-slice-left: 1;">
        <ui:VisualElement name="TitleBox" style="flex-grow: 0; width: auto; height: auto; position: relative; right: auto; left: auto; flex-shrink: 0;">
            <ui:Image source="project://database/Assets/GameAssets/Visuals/UI/UIElements/Logo%20gry%20%E2%80%9ENiesko%C5%84czony%20Bieg%E2%80%9D.png?fileID=2800000&amp;guid=e2794738b9281c64781046029e3e0bbf&amp;type=3#Logo gry „Nieskończony Bieg”" name="Title" style="height: 154px; width: 525px; align-items: stretch;"/>
        </ui:VisualElement>
        <ui:VisualElement name="GameGoalBox" style="flex-grow: 0; -unity-font-definition: url(&quot;project://database/Assets/GameAssets/Visuals/Kaph_Font_1_20/OpenType%20(.otf)/Kaph-Italic.otf?fileID=12800000&amp;guid=6a8dfb149faf0394880c2799514cbdf8&amp;type=3#Kaph-Italic&quot;); -unity-font-style: normal; flex-direction: row; align-items: center;">
            <ui:Label text="Collect Coins" name="CollectText" class="text"/>
            <ui:VisualElement name="Dot" style="flex-grow: 1; color: rgb(111, 98, 73); -unity-background-image-tint-color: rgb(224, 92, 92); width: 10px; height: 10px; background-color: rgb(209, 131, 39); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
            <ui:Label text="Travel Far&#10;" name="TravelText" class="text"/>
            <ui:VisualElement name="Dot" style="flex-grow: 1; color: rgb(111, 98, 73); -unity-background-image-tint-color: rgb(224, 92, 92); width: 10px; height: 10px; background-color: rgb(209, 131, 39); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
            <ui:Label text="Beat Your Record&#10;" name="BeatRecordText" class="text"/>
        </ui:VisualElement>
        <ui:VisualElement name="DividerBox" style="flex-grow: 0; position: relative; flex-shrink: 0;">
            <ui:VisualElement name="Divider" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/GameAssets/Visuals/UI/Divider2.png?fileID=2800000&amp;guid=511d8f9b5171ccf40af47f2d08fa20ac&amp;type=3#Divider2&quot;); width: 647px; height: 15px; color: rgb(22, 21, 21); opacity: 1; display: flex; visibility: visible; overflow: visible; -unity-font-style: normal; -unity-text-outline-color: rgb(46, 45, 45); text-shadow: 0 0 0 rgb(123, 70, 70);"/>
        </ui:VisualElement>
        <ui:VisualElement name="HowToPlayBox" style="flex-grow: 0;">
            <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/GameAssets/Visuals/UI/UIElements/Hexagon.png?fileID=2800000&amp;guid=a15b00d319f1ffd49be98c3418c8385e&amp;type=3#Hexagon&quot;); width: 331px; height: 50px; -unity-slice-right: 0; -unity-slice-left: 0; -unity-slice-scale: 0; -unity-slice-top: 0; -unity-slice-bottom: 0; -unity-background-scale-mode: scale-and-crop; opacity: 0.59; -unity-background-image-tint-color: rgb(48, 44, 44); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; border-left-color: rgb(255, 119, 119); border-right-color: rgb(255, 119, 119); border-top-color: rgb(255, 119, 119); border-bottom-color: rgb(255, 119, 119);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
