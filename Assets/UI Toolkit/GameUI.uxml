            <ui:Label text="Travel Far&#10;" name="TravelText" class="text"/>
            <ui:VisualElement name="Dot" style="flex-grow: 1; color: rgb(111, 98, 73); -unity-background-image-tint-color: rgb(224, 92, 92); width: 10px; height: 10px; background-color: rgb(209, 131, 39); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
