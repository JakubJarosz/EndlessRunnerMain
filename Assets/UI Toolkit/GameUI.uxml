                <ui:VisualElement style="flex-grow: 0; background-image: url(&quot;project://database/Assets/GameAssets/Visuals/UI/UIElements/Bia%C5%82y%20klawisz%20na%20czarnym%20tle.png?fileID=2800000&amp;guid=cf8272bb0045b684686a196a4f18966b&amp;type=3#Biały klawisz na czarnym tle&quot;); flex-direction: column; flex-wrap: nowrap; align-items: center; flex-shrink: 0; flex-basis: auto; justify-content: center; align-self: center; align-content: stretch; white-space: nowrap; text-overflow: clip; -unity-text-outline-width: 0; -unity-background-scale-mode: stretch-to-fill; height: auto; width: auto; -unity-text-align: upper-center; min-width: 50px; min-height: 50px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;">
